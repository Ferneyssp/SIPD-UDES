# ======================= Backend SIPD =======================
# Copie este archivo como backend/.env y ajuste los valores.
DEBUG=True
# Genere una clave: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# PostgreSQL: use DATABASE_URL o las variables DB_* (DATABASE_URL tiene prioridad)
DATABASE_URL=
DB_NAME=sipd
DB_USER=sipd
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# JWT (minutos)
JWT_ACCESS_TOKEN_LIFETIME=30
JWT_REFRESH_TOKEN_LIFETIME=1440

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Umbrales de riesgo (única fuente de verdad)
RISK_LOW_THRESHOLD=0.30
RISK_MEDIUM_THRESHOLD=0.60

# Escala de promedio institucional
GPA_MIN=0.0
GPA_MAX=5.0

# Carga de archivos
UPLOAD_MAX_BYTES=5242880
UPLOAD_MAX_ROWS=50000

# Ubicación de los modelos entrenados (por defecto backend/ml_models)
# ML_MODELS_DIR=

# Reentrenamiento desde la web: thread (por defecto) | worker (python manage.py process_training_runs) | disabled
# En Vercel el valor por defecto es disabled (disco efímero y tiempo máximo de función).
# ML_TRAINING_EXECUTOR=thread
# Minutos sin latido para considerar interrumpida una ejecución
# ML_TRAINING_STALE_MINUTES=10
# Mínimos técnicos del dataset de entrenamiento (partición estratificada 75/25)
# ML_TRAINING_MIN_ROWS=100
# ML_TRAINING_MIN_CLASS_ROWS=10
# Criterios de aceptación OPCIONALES sobre el conjunto de prueba (vacío = sin mínimo; deben fijarlos la institución)
# ML_ACCEPTANCE_MIN_F1=
# ML_ACCEPTANCE_MIN_RECALL=
# ML_ACCEPTANCE_MIN_PRECISION=
# ML_ACCEPTANCE_MIN_ROC_AUC=

# Correo para recuperar contraseña (Gmail: cuenta con verificación en dos pasos + "contraseña de aplicación").
# Sin EMAIL_HOST_USER los correos se muestran en la consola del backend.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=sipd.udes@gmail.com
# EMAIL_HOST_PASSWORD=xxxxxxxxxxxxxxxx
# DEFAULT_FROM_EMAIL=SIPD UDES <sipd.udes@gmail.com>
# Dirección pública del frontend (va en el enlace del correo) y vigencia del enlace en segundos
# FRONTEND_URL=http://localhost:5173
# PASSWORD_RESET_TIMEOUT=1800
# PASSWORD_RESET_THROTTLE_RATE=5/hour

# Reportes
# INSTITUTION_NAME=Institución de Educación Superior
# REPORT_EXPORT_MAX_ROWS=50000

# Contraseña de los usuarios de demostración creados por `manage.py seed_demo`
DEMO_PASSWORD=
