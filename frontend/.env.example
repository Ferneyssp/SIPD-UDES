# URL base de la API. Con "/api" se usa el proxy de Vite (desarrollo) o de Nginx (Docker).
VITE_API_URL=/api
# Destino del proxy de desarrollo (sólo `npm run dev`)
VITE_PROXY_TARGET=http://localhost:8000
# Identidad institucional mostrada en la interfaz
VITE_APP_NAME=SIPD-UDES
VITE_INSTITUTION_NAME=Universidad de Santander
