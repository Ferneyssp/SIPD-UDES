# ========== Variables para docker compose (copie como .env) ==========
DEBUG=False
SECRET_KEY=
DB_NAME=sipd
DB_USER=sipd
DB_PASSWORD=
JWT_ACCESS_TOKEN_LIFETIME=30
JWT_REFRESH_TOKEN_LIFETIME=1440
CORS_ALLOWED_ORIGINS=http://localhost:5173
RISK_LOW_THRESHOLD=0.30
RISK_MEDIUM_THRESHOLD=0.60
# true = carga datos SINTÉTICOS de demostración al iniciar (sólo si la BD está vacía)
SEED_DEMO=true
DEMO_PASSWORD=
# Reentrenamiento desde la web (thread | worker | disabled) y mínimos OPCIONALES de aceptación
ML_TRAINING_EXECUTOR=thread
ML_ACCEPTANCE_MIN_F1=
ML_ACCEPTANCE_MIN_RECALL=
INSTITUTION_NAME=Universidad de Santander
VITE_APP_NAME=SIPD-UDES
VITE_INSTITUTION_NAME=Universidad de Santander
